#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5ef78d36cb00 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5ef78d36cc90 .scope module, "right_shift_tb" "right_shift_tb" 3 1;
 .timescale 0 0;
v0x5ef78d37fdc0_0 .var "a", 3 0;
v0x5ef78d37feb0_0 .net "y", 3 0, L_0x5ef78d3800a0;  1 drivers
S_0x5ef78d333500 .scope module, "dut" "right_shift" 3 5, 4 1 0, S_0x5ef78d36cc90;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /OUTPUT 4 "y";
v0x5ef78d3336e0_0 .net *"_ivl_2", 2 0, L_0x5ef78d37ff80;  1 drivers
L_0x78b406291018 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5ef78d37fae0_0 .net *"_ivl_4", 0 0, L_0x78b406291018;  1 drivers
v0x5ef78d37fbc0_0 .net "a", 3 0, v0x5ef78d37fdc0_0;  1 drivers
v0x5ef78d37fc80_0 .net "y", 3 0, L_0x5ef78d3800a0;  alias, 1 drivers
L_0x5ef78d37ff80 .part v0x5ef78d37fdc0_0, 1, 3;
L_0x5ef78d3800a0 .concat [ 3 1 0 0], L_0x5ef78d37ff80, L_0x78b406291018;
    .scope S_0x5ef78d36cc90;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "right_shift.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5ef78d36cc90 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5ef78d36cc90;
T_1 ;
    %vpi_call/w 3 14 "$monitor", "a=%b y=%b", $time, v0x5ef78d37fdc0_0, v0x5ef78d37feb0_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5ef78d37fdc0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5ef78d37fdc0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5ef78d37fdc0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x5ef78d37fdc0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5ef78d37fdc0_0, 0, 4;
    %delay 10, 0;
    %delay 10, 0;
    %vpi_call/w 3 22 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "right_shift_tb.v";
    "right_shift.v";
