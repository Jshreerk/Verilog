:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56bbe8ce9940 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56bbe8cfcb00 .scope module, "tb_left_shift" "tb_left_shift" 3 1;
 .timescale 0 0;
v0x56bbe8d0e220_0 .var "in", 3 0;
v0x56bbe8d0e310_0 .net "out", 3 0, L_0x56bbe8d0e500;  1 drivers
S_0x56bbe8cfcc90 .scope module, "dut" "left_shift" 3 5, 4 1 0, S_0x56bbe8cfcb00;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "in";
    .port_info 1 /OUTPUT 4 "out";
v0x56bbe8cc3500_0 .net *"_ivl_2", 2 0, L_0x56bbe8d0e3e0;  1 drivers
L_0x7573e10e4018 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x56bbe8d0df40_0 .net *"_ivl_4", 0 0, L_0x7573e10e4018;  1 drivers
v0x56bbe8d0e020_0 .net "in", 3 0, v0x56bbe8d0e220_0;  1 drivers
v0x56bbe8d0e0e0_0 .net "out", 3 0, L_0x56bbe8d0e500;  alias, 1 drivers
L_0x56bbe8d0e3e0 .part v0x56bbe8d0e220_0, 0, 3;
L_0x56bbe8d0e500 .concat [ 1 3 0 0], L_0x7573e10e4018, L_0x56bbe8d0e3e0;
    .scope S_0x56bbe8cfcb00;
T_0 ;
    %vpi_call/w 3 11 "$monitor", "in=%b out=%b", v0x56bbe8d0e220_0, v0x56bbe8d0e310_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x56bbe8d0e220_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x56bbe8d0e220_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x56bbe8d0e220_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x56bbe8d0e220_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x56bbe8d0e220_0, 0, 4;
    %delay 10, 0;
    %vpi_call/w 3 19 "$finish" {0 0 0};
    %end;
    .thread T_0;
