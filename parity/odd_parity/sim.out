#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5ae01d04a8a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5ae01d04aa30 .scope module, "tb_parity_generator" "tb_parity_generator" 3 1;
 .timescale 0 0;
v0x5ae01d05c830_0 .var "data", 3 0;
v0x5ae01d05c8f0_0 .net "parity", 0 0, L_0x5ae01d05c9c0;  1 drivers
S_0x5ae01d011500 .scope module, "dut" "parity_generator" 3 5, 4 1 0, S_0x5ae01d04aa30;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "data";
    .port_info 1 /OUTPUT 1 "parity";
v0x5ae01d0116e0_0 .net "data", 3 0, v0x5ae01d05c830_0;  1 drivers
v0x5ae01d05c710_0 .net "parity", 0 0, L_0x5ae01d05c9c0;  alias, 1 drivers
L_0x5ae01d05c9c0 .reduce/xnor v0x5ae01d05c830_0;
    .scope S_0x5ae01d04aa30;
T_0 ;
    %vpi_call/w 3 11 "$monitor", "time=%0t data=%b odd_parity=%b", $time, v0x5ae01d05c830_0, v0x5ae01d05c8f0_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5ae01d05c830_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5ae01d05c830_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5ae01d05c830_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5ae01d05c830_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x5ae01d05c830_0, 0, 4;
    %delay 10, 0;
    %vpi_call/w 3 19 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "odd_parity_tb.v";
    "odd_parity.v";
