#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fa889e4f0f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fa889e4f280 .scope module, "d_flipflop_rst_tb" "d_flipflop_rst_tb" 3 1;
 .timescale 0 0;
v0x5fa889e63270_0 .var "a", 0 0;
v0x5fa889e63330_0 .var "clk", 0 0;
v0x5fa889e63400_0 .var "rst", 0 0;
v0x5fa889e63500_0 .net "y", 0 0, v0x5fa889e63100_0;  1 drivers
S_0x5fa889e15500 .scope module, "dut" "d_flipflop_rst" 3 5, 4 1 0, S_0x5fa889e4f280;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "a";
    .port_info 3 /OUTPUT 1 "y";
v0x5fa889e15750_0 .net "a", 0 0, v0x5fa889e63270_0;  1 drivers
v0x5fa889e62f70_0 .net "clk", 0 0, v0x5fa889e63330_0;  1 drivers
v0x5fa889e63030_0 .net "rst", 0 0, v0x5fa889e63400_0;  1 drivers
v0x5fa889e63100_0 .var "y", 0 0;
E_0x5fa889e4fbd0 .event posedge, v0x5fa889e62f70_0;
    .scope S_0x5fa889e15500;
T_0 ;
    %wait E_0x5fa889e4fbd0;
    %load/vec4 v0x5fa889e63030_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x5fa889e63100_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5fa889e15750_0;
    %assign/vec4 v0x5fa889e63100_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5fa889e4f280;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fa889e63330_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x5fa889e4f280;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x5fa889e63330_0;
    %inv;
    %store/vec4 v0x5fa889e63330_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x5fa889e4f280;
T_3 ;
    %vpi_call/w 3 16 "$dumpfile", "d_flipflop.vcd" {0 0 0};
    %vpi_call/w 3 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fa889e4f280 {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x5fa889e4f280;
T_4 ;
    %vpi_call/w 3 21 "$monitor", "clk=%b, rst=%b, a=%b | y=%b", v0x5fa889e63330_0, v0x5fa889e63400_0, v0x5fa889e63270_0, v0x5fa889e63500_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fa889e63400_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fa889e63330_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fa889e63270_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fa889e63400_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fa889e63330_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fa889e63270_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fa889e63400_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fa889e63330_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fa889e63270_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_4;
