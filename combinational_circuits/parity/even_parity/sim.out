#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x639ecd8b48a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x639ecd8b4a30 .scope module, "even_parity_tb" "even_parity_tb" 3 1;
 .timescale 0 0;
v0x639ecd8c72e0_0 .var "data", 3 0;
v0x639ecd8c73a0_0 .net "parity", 0 0, L_0x639ecd8c7470;  1 drivers
S_0x639ecd87b500 .scope module, "dut" "even_parity" 3 5, 4 1 0, S_0x639ecd8b4a30;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "data";
    .port_info 1 /OUTPUT 1 "parity";
v0x639ecd87b6e0_0 .net "data", 3 0, v0x639ecd8c72e0_0;  1 drivers
v0x639ecd8c71c0_0 .net "parity", 0 0, L_0x639ecd8c7470;  alias, 1 drivers
L_0x639ecd8c7470 .reduce/xor v0x639ecd8c72e0_0;
    .scope S_0x639ecd8b4a30;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "even_parity.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x639ecd8b4a30 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x639ecd8b4a30;
T_1 ;
    %vpi_call/w 3 14 "$monitor", "time=%0t data=%b parity=%b", $time, v0x639ecd8c72e0_0, v0x639ecd8c73a0_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x639ecd8c72e0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x639ecd8c72e0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x639ecd8c72e0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x639ecd8c72e0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x639ecd8c72e0_0, 0, 4;
    %delay 10, 0;
    %vpi_call/w 3 22 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "even_parity_tb.v";
    "even_parity.v";
