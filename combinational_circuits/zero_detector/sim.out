#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x6160c6cda8d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x6160c6cdaa60 .scope module, "zero_detector_tb" "zero_detector_tb" 3 1;
 .timescale 0 0;
v0x6160c6cebf90_0 .var "a", 3 0;
v0x6160c6cec080_0 .net "y", 0 0, L_0x6160c6cec180;  1 drivers
S_0x6160c6ca1500 .scope module, "dut" "zero_detector" 3 4, 4 1 0, S_0x6160c6cdaa60;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x7c5ebc691018 .functor BUFT 1, C4<0000>, C4<0>, C4<0>, C4<0>;
v0x6160c6ca16e0_0 .net/2u *"_ivl_0", 3 0, L_0x7c5ebc691018;  1 drivers
v0x6160c6cebdb0_0 .net "a", 3 0, v0x6160c6cebf90_0;  1 drivers
v0x6160c6cebe90_0 .net "y", 0 0, L_0x6160c6cec180;  alias, 1 drivers
L_0x6160c6cec180 .cmp/eq 4, v0x6160c6cebf90_0, L_0x7c5ebc691018;
    .scope S_0x6160c6cdaa60;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "zero_detector.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6160c6cdaa60 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x6160c6cdaa60;
T_1 ;
    %vpi_call/w 3 13 "$monitor", "a=%b|y=%b", v0x6160c6cebf90_0, v0x6160c6cec080_0 {0 0 0};
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x6160c6cebf90_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x6160c6cebf90_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x6160c6cebf90_0, 0, 4;
    %delay 10, 0;
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "zero_detector_tb.v";
    "zero_detector.v";
