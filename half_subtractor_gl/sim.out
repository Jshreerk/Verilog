v0x644e6f6127c0_0 .net "diff", 0 0, L_0x644e6f612cb0;  alias, 1 drivers
    .scope S_0x644e6f5ff500;
T_0 ;
    %vpi_call/w 3 8 "$dumpfile", "half_subtractor.vcd" {0 0 0};
    %vpi_call/w 3 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x644e6f5ff500 {0 0 0};
    %end;
    .thread T_0;
