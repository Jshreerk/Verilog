T_1 ;
    %vpi_call/w 3 12 "$monitor", "a=%b, b=%b | diff=%b, borrow=%b", v0x644e6f612950_0, v0x644e6f612a10_0, v0x644e6f612be0_0, v0x644e6f612ae0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
