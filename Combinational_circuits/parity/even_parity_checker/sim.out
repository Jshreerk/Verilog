#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5e62c1f388d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5e62c1f38a60 .scope module, "even_parity_checker_tb" "even_parity_checker_tb" 3 1;
 .timescale 0 0;
v0x5e62c1f4a160_0 .var "data", 3 0;
v0x5e62c1f4a220_0 .net "parity", 0 0, L_0x5e62c1f4a2f0;  1 drivers
S_0x5e62c1eff500 .scope module, "dut" "even_parity_checker" 3 4, 4 1 0, S_0x5e62c1f38a60;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "data";
    .port_info 1 /OUTPUT 1 "parity";
v0x5e62c1eff6e0_0 .net "data", 3 0, v0x5e62c1f4a160_0;  1 drivers
v0x5e62c1f4a040_0 .net "parity", 0 0, L_0x5e62c1f4a2f0;  alias, 1 drivers
L_0x5e62c1f4a2f0 .reduce/xor v0x5e62c1f4a160_0;
    .scope S_0x5e62c1f38a60;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "even_parity_checker.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e62c1f38a60 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5e62c1f38a60;
T_1 ;
    %vpi_call/w 3 13 "$monitor", "data=%b|parity=%b", v0x5e62c1f4a160_0, v0x5e62c1f4a220_0 {0 0 0};
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5e62c1f4a160_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x5e62c1f4a160_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 14, 0, 4;
    %store/vec4 v0x5e62c1f4a160_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5e62c1f4a160_0, 0, 4;
    %delay 10, 0;
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "even_parity_checker_tb.v";
    "even_parity_checker.v";
