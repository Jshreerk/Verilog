#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5626a30918a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5626a3091a30 .scope module, "odd_parity_checker_tb" "odd_parity_checker_tb" 3 1;
 .timescale 0 0;
v0x5626a30a46a0_0 .var "data", 3 0;
v0x5626a30a4760_0 .net "parity", 0 0, L_0x5626a30a4830;  1 drivers
S_0x5626a3058500 .scope module, "dut" "odd_parity_checker" 3 5, 4 1 0, S_0x5626a3091a30;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "data";
    .port_info 1 /OUTPUT 1 "parity";
v0x5626a30586e0_0 .net "data", 3 0, v0x5626a30a46a0_0;  1 drivers
v0x5626a30a4580_0 .net "parity", 0 0, L_0x5626a30a4830;  alias, 1 drivers
L_0x5626a30a4830 .reduce/xnor v0x5626a30a46a0_0;
    .scope S_0x5626a3091a30;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "odd_parity_checker.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5626a3091a30 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5626a3091a30;
T_1 ;
    %vpi_call/w 3 14 "$monitor", "time=%0t data=%b parity=%b", $time, v0x5626a30a46a0_0, v0x5626a30a4760_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5626a30a46a0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5626a30a46a0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5626a30a46a0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5626a30a46a0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x5626a30a46a0_0, 0, 4;
    %delay 10, 0;
    %vpi_call/w 3 22 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "odd_parity_checker_tb.v";
    "odd_parity_checker.v";
