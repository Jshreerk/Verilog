v0x5a98ea2f8ca0_0 .net "y", 7 0, L_0x5a98ea2f9340;  alias, 1 drivers
L_0x5a98ea2f9090 .concat [ 4 4 0 0], v0x5a98ea2f8e00_0, L_0x70d4b2830018;
L_0x5a98ea2f9200 .concat [ 4 4 0 0], v0x5a98ea2f8ec0_0, L_0x70d4b2830060;
L_0x5a98ea2f9340 .arith/sum 8, L_0x5a98ea2f9090, L_0x5a98ea2f9200;
    .scope S_0x5a98ea2e6f50;
T_0 ;
    %vpi_call/w 3 12 "$monitor", "a=%d, b=%d | y=%d", v0x5a98ea2f8e00_0, v0x5a98ea2f8ec0_0, v0x5a98ea2f8f90_0 {0 0 0};
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5a98ea2f8e00_0, 0, 4;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5a98ea2f8ec0_0, 0, 4;
    %delay 10, 0;
