#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x63f1f83a2630 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x63f1f83a27e0 .scope module, "non_blocking_multiplication" "non_blocking_multiplication" 3 1;
 .timescale 0 0;
v0x63f1f83c81a0_0 .var "a", 3 0;
    .scope S_0x63f1f83a27e0;
T_0 ;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x63f1f83c81a0_0, 0, 4;
    %load/vec4 v0x63f1f83c81a0_0;
    %muli 2, 0, 4;
    %assign/vec4 v0x63f1f83c81a0_0, 0;
    %delay 1, 0;
    %vpi_call/w 3 9 "$display", "a=%b", v0x63f1f83c81a0_0 {0 0 0};
    %vpi_call/w 3 10 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "multiplication.v";
