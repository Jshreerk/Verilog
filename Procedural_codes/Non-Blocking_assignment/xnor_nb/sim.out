#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fba87349600 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fba873497b0 .scope module, "xnor_nb" "xnor_nb" 3 1;
 .timescale 0 0;
v0x5fba8736fbf0_0 .var "a", 3 0;
v0x5fba87391740_0 .var "b", 3 0;
v0x5fba87391820_0 .var "c", 3 0;
    .scope S_0x5fba873497b0;
T_0 ;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5fba8736fbf0_0, 0, 4;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x5fba87391740_0, 0, 4;
    %load/vec4 v0x5fba8736fbf0_0;
    %load/vec4 v0x5fba87391740_0;
    %xor;
    %inv;
    %assign/vec4 v0x5fba87391820_0, 0;
    %delay 1, 0;
    %vpi_call/w 3 10 "$display", "a = %b, b = %b, c = %b", v0x5fba8736fbf0_0, v0x5fba87391740_0, v0x5fba87391820_0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "xnor.v";
