#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x58fd4f41d630 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x58fd4f41d7e0 .scope module, "non_blocking_swap" "non_blocking_swap" 3 1;
 .timescale 0 0;
v0x58fd4f4436c0_0 .var "a", 0 0;
v0x58fd4f464fc0_0 .var "b", 0 0;
    .scope S_0x58fd4f41d7e0;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58fd4f4436c0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58fd4f464fc0_0, 0, 1;
    %load/vec4 v0x58fd4f464fc0_0;
    %assign/vec4 v0x58fd4f4436c0_0, 0;
    %load/vec4 v0x58fd4f4436c0_0;
    %assign/vec4 v0x58fd4f464fc0_0, 0;
    %delay 3, 0;
    %vpi_call/w 3 9 "$display", "a=%d, b=%d", v0x58fd4f4436c0_0, v0x58fd4f464fc0_0 {0 0 0};
    %vpi_call/w 3 10 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "swap_nb.v";
