#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x62f6bfca6600 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x62f6bfca67b0 .scope module, "blocking_addition" "blocking_addition" 3 1;
 .timescale 0 0;
v0x62f6bfcccba0_0 .var "a", 3 0;
v0x62f6bfcee810_0 .var "b", 3 0;
v0x62f6bfcee8f0_0 .var "y", 4 0;
    .scope S_0x62f6bfca67b0;
T_0 ;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x62f6bfcccba0_0, 0, 4;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x62f6bfcee810_0, 0, 4;
    %load/vec4 v0x62f6bfcccba0_0;
    %pad/u 5;
    %load/vec4 v0x62f6bfcee810_0;
    %pad/u 5;
    %sub;
    %assign/vec4 v0x62f6bfcee8f0_0, 0;
    %delay 10, 0;
    %vpi_call/w 3 11 "$display", "a=%d, b=%d | y=%d", v0x62f6bfcccba0_0, v0x62f6bfcee810_0, v0x62f6bfcee8f0_0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "subtraction.v";
