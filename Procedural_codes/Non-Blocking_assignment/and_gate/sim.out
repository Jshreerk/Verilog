#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fc5eb05c630 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fc5eb05c7e0 .scope module, "non_blocking_and" "non_blocking_and" 3 1;
 .timescale 0 0;
v0x5fc5eb082500_0 .var "a", 0 0;
v0x5fc5eb0a3dd0_0 .var "b", 0 0;
v0x5fc5eb0a3e90_0 .var "c", 0 0;
    .scope S_0x5fc5eb05c7e0;
T_0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fc5eb082500_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fc5eb0a3dd0_0, 0, 1;
    %load/vec4 v0x5fc5eb082500_0;
    %flag_set/vec4 8;
    %flag_get/vec4 8;
    %jmp/0 T_0.0, 8;
    %load/vec4 v0x5fc5eb0a3dd0_0;
    %and;
T_0.0;
    %assign/vec4 v0x5fc5eb0a3e90_0, 0;
    %delay 2, 0;
    %vpi_call/w 3 10 "$display", "c=%b", v0x5fc5eb0a3e90_0 {0 0 0};
    %vpi_call/w 3 11 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "and_gate.v";
