#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5f8289e2ebe0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5f8289e2ed70 .scope module, "comparator_tb" "comparator_tb" 3 1;
 .timescale 0 0;
v0x5f8289e41a10_0 .var "a", 1 0;
v0x5f8289e41b00_0 .var "b", 1 0;
v0x5f8289e41bd0_0 .net "y", 0 0, L_0x5f8289e41cd0;  1 drivers
S_0x5f8289df5500 .scope module, "dut" "comparator" 3 6, 4 1 0, S_0x5f8289e2ed70;
 .timescale 0 0;
    .port_info 0 /INPUT 2 "a";
    .port_info 1 /INPUT 2 "b";
    .port_info 2 /OUTPUT 1 "y";
v0x5f8289df56e0_0 .net "a", 1 0, v0x5f8289e41a10_0;  1 drivers
v0x5f8289e41810_0 .net "b", 1 0, v0x5f8289e41b00_0;  1 drivers
v0x5f8289e418f0_0 .net "y", 0 0, L_0x5f8289e41cd0;  alias, 1 drivers
L_0x5f8289e41cd0 .cmp/eq 2, v0x5f8289e41a10_0, v0x5f8289e41b00_0;
    .scope S_0x5f8289e2ed70;
T_0 ;
    %vpi_call/w 3 13 "$dumpfile", "comparator.vcd" {0 0 0};
    %vpi_call/w 3 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5f8289e2ed70 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5f8289e2ed70;
T_1 ;
    %vpi_call/w 3 17 "$monitor", "a=%b, b=%b | y=%b", v0x5f8289e41a10_0, v0x5f8289e41b00_0, v0x5f8289e41bd0_0 {0 0 0};
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5f8289e41a10_0, 0, 2;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5f8289e41b00_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5f8289e41a10_0, 0, 2;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5f8289e41b00_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5f8289e41a10_0, 0, 2;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5f8289e41b00_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5f8289e41a10_0, 0, 2;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5f8289e41b00_0, 0, 2;
    %delay 10, 0;
    %vpi_call/w 3 22 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "comparator_tb.v";
    "comparator.v";
