#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a63227e0e70 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a63227e1000 .scope module, "half_adder_tb" "half_adder_tb" 3 1;
 .timescale 0 0;
v0x5a63227f45a0_0 .var "a", 0 0;
v0x5a63227f4660_0 .var "b", 0 0;
v0x5a63227f4730_0 .net "carry", 0 0, L_0x5a63227f4a60;  1 drivers
v0x5a63227f4830_0 .net "sum", 0 0, L_0x5a63227f4900;  1 drivers
S_0x5a63227a7500 .scope module, "dut" "half_adder" 3 5, 4 1 0, S_0x5a63227e1000;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
L_0x5a63227f4900 .functor XOR 1, v0x5a63227f45a0_0, v0x5a63227f4660_0, C4<0>, C4<0>;
L_0x5a63227f4a60 .functor AND 1, v0x5a63227f45a0_0, v0x5a63227f4660_0, C4<1>, C4<1>;
v0x5a63227a7750_0 .net "a", 0 0, v0x5a63227f45a0_0;  1 drivers
v0x5a63227f4300_0 .net "b", 0 0, v0x5a63227f4660_0;  1 drivers
v0x5a63227f43c0_0 .net "carry", 0 0, L_0x5a63227f4a60;  alias, 1 drivers
v0x5a63227f4460_0 .net "sum", 0 0, L_0x5a63227f4900;  alias, 1 drivers
    .scope S_0x5a63227e1000;
T_0 ;
    %vpi_call/w 3 12 "$dumpfile", "half_adder.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a63227e1000 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5a63227e1000;
T_1 ;
    %vpi_call/w 3 16 "$monitor", "a=%b, b=%b | sum=%b, carry=%b", v0x5a63227f45a0_0, v0x5a63227f4660_0, v0x5a63227f4830_0, v0x5a63227f4730_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a63227f45a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a63227f4660_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a63227f45a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a63227f4660_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a63227f45a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a63227f4660_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a63227f45a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a63227f4660_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 21 "$finish" {0 0 0};
    %end;
    .thread T_1;
